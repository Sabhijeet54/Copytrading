# =====================================================================
# Copy Trading Platform — environment variables
# Copy to `.env` in the repo root:  cp .env.example .env
# NEVER commit a real .env. NEVER put secrets in NEXT_PUBLIC_* variables.
# =====================================================================

# --- Runtime -----------------------------------------------------------
# development | staging | production
APP_ENV=development
NODE_ENV=development

# --- Database / Redis --------------------------------------------------
DATABASE_URL=postgresql://ctp:ctp_dev_password@localhost:5432/copy_trading?schema=public
REDIS_URL=redis://localhost:6379

# --- Security ----------------------------------------------------------
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (seconds) and refresh session lifetime (days)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# 32-byte key, base64 encoded, used for AES-256-GCM encryption of broker tokens.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- API ---------------------------------------------------------------
API_PORT=4000
# Public origin of the web app (CORS + links in emails)
WEB_ORIGIN=http://localhost:3000
# Public base URL of the API (used to build broker callback URLs)
API_PUBLIC_URL=http://localhost:4000
# Set true in staging/production (HTTPS). Cookies become Secure.
COOKIE_SECURE=false
# Require email verification before login (architecture is in place; set true once SMTP is configured)
REQUIRE_EMAIL_VERIFICATION=false
# Behind Railway / a reverse proxy, trust X-Forwarded-* for client IPs (rate limiting)
TRUST_PROXY=false

# --- Email (optional; when SMTP_HOST is empty, emails are written to the API log in development only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Copy Trading Platform <no-reply@example.com>"

# --- Web (Next.js) -----------------------------------------------------
# Server-side only: where Next.js proxies /api/* requests (rewrites).
API_INTERNAL_URL=http://localhost:4000

# --- Trading safety ----------------------------------------------------
# When true, NO real broker orders are ever placed. Keep true until paper trading is validated.
PAPER_MODE=true

# --- Zerodha Kite Connect (Phase 4) -------------------------------------
# From https://developers.kite.trade — the redirect URL must match the one registered on your Kite app.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:4000/brokers/zerodha/callback

# --- Angel One SmartAPI (Phase 5) ---------------------------------------
# From https://smartapi.angelbroking.com — redirect URL is configured on the SmartAPI app.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_CLIENT_SECRET=
ANGEL_REDIRECT_URL=

# --- Seed (development only) -------------------------------------------
# Passwords for seeded demo users. If empty, the seed uses the documented dev defaults.
SEED_ADMIN_PASSWORD=
SEED_MASTER_PASSWORD=
SEED_FOLLOWER_PASSWORD=

# --- Worker ------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Static IP registered on the SmartAPI app (sent as X-ClientPublicIP)
ANGEL_PUBLIC_IP=
ANGEL_LOCAL_IP=
ANGEL_MAC_ADDRESS=
ANGEL_PROXY_URL=
# Optional static-IP egress proxy for broker calls: http://user:pass@host:port (whitelist its exit IP at the broker)
ZERODHA_PROXY_URL=

# --- Copy engine ---------------------------------------------------------
# How often (ms) master order books are polled to detect trades placed in the broker's own app. 0 = off.
COPY_POLL_INTERVAL_MS=5000

# ---- Realtime / alerts / risk (added 2026-10-13) ----
# Telegram alerts (optional): bot token from @BotFather and the admin chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# IST time for auto square-off of INTRADAY copy positions (empty = disabled)
AUTO_SQUARE_OFF_TIME=15:15
# Master feed is restarted after this many seconds without ticks (market hours)
FEED_STALE_SECONDS=30
# Broker order throttles (orders/second across all clients)
ORDER_RATE_PER_SEC_ZERODHA=10
ORDER_RATE_PER_SEC_ANGEL=10
TOKEN_EXPIRY_CHECK_MS=60000
RISK_POLL_INTERVAL_MS=30000
